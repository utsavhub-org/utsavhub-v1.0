# ==========================================
# UtsavHub Mobile - Environment Configuration
# ==========================================

# 1. Supabase Backend (Database, Auth, Row-Level Security)
# Obtain these from: https://supabase.com/dashboard/project/<your-project>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Cloudflare R2 Media Storage (Zero-Egress Fee Video Reels, Photos, PDFs)
# Obtain these from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
EXPO_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
EXPO_PUBLIC_CLOUDFLARE_R2_BUCKET_NAME=utsavhub-media
EXPO_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.utsavhub.com
EXPO_PUBLIC_CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
EXPO_PUBLIC_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key


# 3. Firebase Phone Authentication
# Obtain these from: https://console.firebase.google.com/ > Project Settings > Web App
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
